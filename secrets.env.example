AZURE_FOUNDRY_API_KEY=your-azure-foundry-key
# Passphrase users must enter on the sign-in screen. Pick something long and random.
APP_ACCESS_CODE=choose-a-long-random-access-code
# Your Azure AI Foundry resource endpoint (required). Not a secret by itself, but keep your resource name out of the repo.
AZURE_FOUNDRY_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
